{
  "name": "safeer_api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "concurrently -k -n tsc,run -c blue,green \"npm:dev:build\" \"npm:dev:run\"",
    "start:debug": "concurrently -k -n tsc,run -c blue,green \"npm:dev:build\" \"nodemon --watch dist --ext js --delay 300ms --exec \"node --enable-source-maps --inspect dist/main.js\"\"",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "dev:build": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:run": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && nodemon --watch dist --ext js --delay 300ms --exec \"node --enable-source-maps dist/main.js\"",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "db:reset": "node scripts/db-reset.mjs",
    "seed": "node tools/seed-from-prototype.mjs",
    "schema:check": "node scripts/check-schema.mjs",
    "schema:log": "typeorm schema:log -d dist/database/data-source.js",
    "openapi": "node scripts/export-openapi.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "check:admin-roles": "node scripts/check-admin-roles.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "media:reprocess": "node scripts/reprocess-media.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.15",
    "file-type": "^22.1.0",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.1",
    "lru-cache": "^11.5.2",
    "marked": "^18.0.13",
    "mysql2": "^3.24.4",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
