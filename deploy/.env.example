# deploy/.env — compose's own variables (interpolation), read from the
# directory docker-compose.yml is in. Copy to /srv/safeer/.env, fill in,
# chmod 600. Never commit the filled-in copy.

# Image tags (GHCR, published by each repo's image.yml on a v* tag).
# Updates and rollbacks are a change here + `docker compose pull && up -d`.
SAFEER_API_TAG=v1.0.0
SAFEER_WEB_TAG=v1.0.0

# The edge Caddy's Docker network. Find it with:
#   docker network ls
#   grep -A5 '^networks:' /srv/edge/docker-compose.yml
# (a network `web` declared in the edge project is usually named `edge_web`).
EDGE_NETWORK=

# The public origin, no trailing slash. Staging first, then the apex at
# cutover (DEPLOYMENT-VPS.md). Becomes the API's FRONTEND_BASE_URL and
# CORS_ORIGINS and the web server's PUBLIC_SITE_URL.
SITE_URL=https://new.safeer-sa.org

# The migration account (DDL rights). The db container creates it on its
# first start; only `docker compose run --rm migrate` uses it.
# Generate the password with:  openssl rand -hex 24
MIGRATION_DB_USER=safeer_migrator
MIGRATION_DB_PASSWORD=
