# deploy/db.env — read only by the db container. Copy to /srv/safeer/db.env,
# fill in, chmod 600. Never commit the filled-in copy.
#
# Root is used for one-off admin work (creating the app user, backup.sh's
# dump), always from inside the container. Generate with:
#   openssl rand -hex 32
# It takes effect only on the first start of an empty dbdata volume;
# changing it later needs ALTER USER inside MySQL as well.
MYSQL_ROOT_PASSWORD=
