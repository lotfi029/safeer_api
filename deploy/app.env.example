# deploy/app.env — the API's settings (api and migrate services). Copy to
# /srv/safeer/app.env, fill in, chmod 600. Never commit the filled-in copy.
# README.md's env table documents every variable. Set in docker-compose.yml,
# so not here: DB_HOST, DB_PORT, FRONTEND_BASE_URL and CORS_ORIGINS (from
# SITE_URL). Set by the image: NODE_ENV=production, HOST=0.0.0.0, PORT=3900,
# STORAGE_ROOT=/data/storage.

# The least-privilege runtime account (deploy/create-app-db-user.sql, created
# after the first migrate). The grants name the database, so keep `safeer`.
# Generate the password with:  openssl rand -hex 24
DB_NAME=safeer
DB_USER=safeer_app
DB_PASSWORD=

# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# It encrypts the stored SMTP password and applicant ID numbers.
# !! PERMANENT. Store a copy OFFLINE (the association's password manager)
# !! before the first start. Lose it and every encrypted ID number and the
# !! SMTP password are unreadable; a backup restore needs the same key.
# !! Never reuse the CI value in .github/workflows/ci.yml: it is public.
APP_ENCRYPTION_KEY=

# Salt for hashing visitor IPs (ip_hash). Generate with:  openssl rand -hex 32
# Changing it later only breaks continuity of existing ip_hash values.
IP_HASH_SALT=

# The first admin account, created on first boot. Use the association's real
# admin address. Generate a temporary password with:  openssl rand -base64 18
# and change it after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# One proxy (safeer-web) sits directly in front of the API. Don't raise it.
TRUST_PROXY=1

# Sessions (defaults shown).
SESSION_COOKIE_NAME=sf_sid
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=30
APPLICANT_SESSION_COOKIE_NAME=sf_app_sid
APPLICANT_SESSION_IDLE_HOURS=12
APPLICANT_SESSION_ABSOLUTE_DAYS=7

CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Files live on the `storage` volume. For an S3-compatible bucket instead,
# set STORAGE_DRIVER=s3 and every S3_* below (README.md).
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET_PUBLIC=
# S3_BUCKET_PRIVATE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_TTL_SECONDS=300

# Refused at boot in production; must stay false.
ALLOW_DEV_PASSWORD_FIXUP=false

# Mail (SMTP) and SMS (Unifonic) are configured in the admin dashboard, not here.
