# Keep devDependencies installed even when NODE_ENV=production.
#
# npm's `omit` config defaults to `dev` whenever NODE_ENV is 'production'.
# Hostinger passes the application's environment variables into the build, so
# the moment NODE_ENV=production was set on api.darafrica.org the build
# installed 258 packages instead of 525 and died with:
#
#     > nest build
#     sh: line 1: nest: command not found
#
# The build needs @nestjs/cli and typescript, both devDependencies, and there
# is no separate build-time environment to set this in — the same variable
# that the running app requires (src/config/env.ts refuses to start without
# NODE_ENV) is the one npm reads.
#
# `include` wins over `omit` regardless of how omit was set, so this holds
# even if the builder passes --omit=dev explicitly.
#
# The cost is that devDependencies stay in node_modules at runtime. On this
# host the build output *is* the deployed directory, so the alternative would
# be moving build tooling into `dependencies`, which is worse: same disk cost,
# but it lies about what the application needs to run.
include=dev
