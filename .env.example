NODE_ENV=development
PORT=3900

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=safeer

# DDL-capable account for `npm run migrate` / `db:reset` (C29). Required when
# NODE_ENV is staging/production; development/test fall back to DB_USER.
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=

SESSION_COOKIE_NAME=sf_sid
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=30

# Student portal — separate cookie/table pair from the staff session above.
APPLICANT_SESSION_COOKIE_NAME=sf_app_sid
APPLICANT_SESSION_IDLE_HOURS=12
APPLICANT_SESSION_ABSOLUTE_DAYS=7

# 32 bytes, base64 — encrypts the stored SMTP password. PERMANENT once real data exists.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

STORAGE_ROOT=./var/assets

# Storage driver: local (default, everything under STORAGE_ROOT) | s3
# (an S3-compatible bucket). The S3_* vars below are required only when
# STORAGE_DRIVER=s3 — leave them unset for local.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.example-region.example.com
# S3_REGION=us-east-1
# S3_BUCKET_PUBLIC=safeer-public
# S3_BUCKET_PRIVATE=safeer-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_TTL_SECONDS=300

BOOTSTRAP_ADMIN_EMAIL=admin@safeer-sa.org
BOOTSTRAP_ADMIN_PASSWORD=

IP_HASH_SALT=
CORS_ORIGINS=http://localhost:4200
# C2: the public frontend; every emailed/SMS'd link points here, under /{locale}/.
# Required when NODE_ENV is staging/production.
FRONTEND_BASE_URL=http://localhost:4200

CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Dev/staging only — never true when NODE_ENV=production (refused at boot).
# Lets BootstrapService turn a pending invite's placeholder hash into
# BOOTSTRAP_ADMIN_PASSWORD, so a fresh dev database has a usable seeded
# account without hand-editing the database.
ALLOW_DEV_PASSWORD_FIXUP=true
